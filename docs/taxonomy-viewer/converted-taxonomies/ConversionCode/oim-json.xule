/**
output parts
$PART_PROPERTIES

output rel_types

$RELATIONSHIP_TYPES

output domainRoots

$DIMENSION_DOMAINS_SET

output cubes

list("cubes",list(for $cube in $CUBES
          dict(list("name", qname($cube.cube-concept.name.namespace-uri,$cube.cube-concept.name.local-name + "_" + $cube.drs-role.uri.split('\/').last + "_Cube")),
              list("cubeType",qname("https://xbrl.org/2025","reportCube")),
              list("cubeDimensions",list(for $dimension in filter $cube.dimensions 
                  dict(list("dimensionName",$dimension.concept.name),
                      if $dimension.dimension-type == "explicit" list("domainName",qname($dimension.default.name.namespace-uri, $dimension.default.name.local-name + "_" + $cube.drs-role.uri.split('\/').last + "_DDomain")) else list(),
                      if $dimension.dimension-type == "explicit" list("allowDomainFacts",true) else list("allowDomainFacts",false)
                      )
                  ) + list(dict(list("dimensionName",qname("https://xbrl.org/2025","concept")),
                      list("domainName",qname($cube.cube-concept.name.namespace-uri, $cube.cube-concept.name.local-name + "_" + $cube.drs-role.uri.split('\/').last + "_PDomain"))
                      )
                  ) + list(dict(list("dimensionName",qname("https://xbrl.org/2025","period")),
                      list("allowDomainFacts",true)
                      )
                  ) + list(dict(list("dimensionName",qname("https://xbrl.org/2025","unit")),
                      list("allowDomainFacts",true)
                      )
                  ) + list(dict(list("dimensionName",qname("https://xbrl.org/2025","entity"))
                      )
                  )
              ),
              list("cubeNetworks",list(for $network in filter $NETWORKS_NO_DIMS where ($item.arcrole.uri.contains('parent-child') or $item.arcrole.uri.contains('summation-item')) and $item.role.uri == $cube.drs-role.uri
                  qname($CONVERT_TAXONOMY.entry-point-namespace,$network.role.uri.split('\/').last + "_" + $network.arcrole.uri.split('\/').last + "_Network")
                  )
              )
          )
        )
      )


output test

list(for $enum in $EXT_ENUMS_SET
              
                 $enum[1].clark
                 
                                )
output test2

$EXT_ENUMS.clark

output refs

$REFERENCES

output labels

$CUBE_LABELS + $DIM_DOMAIN_LABELS + $PRIM_DOMAIN_LABELS + $GROUP_LABELS + $EXTENUM_DOMAIN_LABELS

output cube_labels

$CUBE_LABELS

output dim_domain_labels

$DIM_DOMAIN_LABELS

output prim_domain_labels

$PRIM_DOMAIN_LABELS

output group_labels

$GROUP_LABELS

output extenum_domain_labels

$EXTENUM_DOMAIN_LABELS

output dimeensions_not_in_cube

$NON_DOMAIN_DIMENSIONS


output domains 

$DIMENSION_DOMAINS + $PRIMARY_DOMAINS + $EXTENUM_DOMAINS


output parts_prop 
$PART_PROPERTIES


output test_cube_networks

list(for $cube in $CUBES
        $amended_cube_URI = if $cube.drs-role.uri.index-of($cube.cube-concept.name.local-name) == 0 $cube.drs-role.uri else $cube.drs-role.uri.substring(1,($cube.drs-role.uri.index-of($cube.cube-concept.name.local-name)))
          dict(list("cube-uri",  $amended_cube_URI),
              
              list("uri",list(for $network in filter $NETWORKS_NO_DIMS where ($item.arcrole.uri.contains('parent-child') or $item.arcrole.uri.contains('summation-item'))
                  $network.role.uri
                  )
              )
          )
        )
**/ 
output test_taxonomy

dict(
    list("documentInfo",dict(
      list("documentType","https://xbrl.org/2026/model"),
      list("namespaces",dict(for $namespace in $NAMESPACES
        if $namespace not in list("http://www.xbrl.org/dtr/type/numeric", "http://www.xbrl.org/dtr/type/non-numeric","http://www.xbrl.org/2003/instance", "http://www.xbrl.org/2006/ref", "http://www.xbrl.org/dtr/type/2022-03-31", "https://xbrl.org/2023/calculation-1.1", "http://www.xbrl.org/2009/arcrole/deprecated", "http://www.xbrl.org/dtr/type/2024-01-31")
          list($namespaceDict[$namespace], $namespace)
        else skip
        )
        + dict(
              list("xbrl","https://xbrl.org/2025"),
              list("xbrli","https://xbrl.org/2025/instance"),
              list("ref","https://xbrl.org/2025/ref"),
              list("xs","http://www.w3.org/2001/XMLSchema")  
        )
      )
      )
    ),
    list("taxonomy",dict(
      list("name",$TAXONOMY_NAME),
      list("frameworkName",$FAMILY_NAME),
      list("version",$VERSION),
      list("abstracts",list(for $abstract in  $ABSTRACTS
        dict(
            list("name",$abstract.name),
            if $abstract.data-type.name.local-name != "stringItemType"
                list("properties",list(
                  dict(list("property",qname("https://xbrl.org/2025","abstractDataType")),
                        list("value",if $BASE_TYPES[$abstract.data-type.name] == none $abstract.data-type.name else $BASE_TYPES[$abstract.data-type.name])
                  )
                )
                )
            else 
            list()
        )
      )
      ),
      list("members",list(for $member in  $MEMBERS
        dict(
            list("name",$member.name)
        )
      )
      ),
      list("concepts", list(for $concept in $CONCEPTS
          dict(
            list("name",$concept.name),
            list("nillable",true),
            list("periodType",$concept.period-type),
            if $concept.balance != none
                list("properties",list(
                  dict(list("property",qname("https://xbrl.org/2025","balance")),
                        list("value",$concept.balance)
                  )
                )
                )
            else
                list(),
            list("dataType",if $BASE_TYPES[$concept.data-type.name] == none $concept.data-type.name else $BASE_TYPES[$concept.data-type.name]),
            if $concept.attribute(enum2:linkrole) != none
              list("enumerationDomain",qname($concept.attribute(enum2:domain).to-qname.namespace-uri, $concept.attribute(enum2:domain).to-qname.local-name + "_" + $concept.attribute(enum2:linkrole).split('\/').last + "_EDomain"))
            else list()
            )
          )
        ),
        list("groups",list(for $role in $COLLAPSED_NETWORKS
          dict(list("name",qname($CONVERT_TAXONOMY.entry-point-namespace, $role.last.split('\/').last + "Group")),
              list("groupURI",$role.last)
          )
        )
      ),
      list("groupContents",list(
          for $role in $COLLAPSED_NETWORKS
            dict(
                list("groupName",qname($CONVERT_TAXONOMY.entry-point-namespace, $role.last.split('\/').last + "Group")),
                list("relatedNames", list(for $network in filter $NETWORKS_NO_DIMS where ($item.arcrole.uri.contains('parent-child') or $item.arcrole.uri.contains('summation-item')) and $item.role.uri == $role.last
                                          qname($CONVERT_TAXONOMY.entry-point-namespace, $network.role.uri.split('\/').last + "_" + $network.arcrole.uri.split('\/').last + "_Network")
                                          ) + list(
                                            $cubeNetwork = $CUBE_URI_DICT[$role.last]
                                            if $cubeNetwork == none
                                              skip
                                            else
                                              for $cube in $cubeNetwork
                                                $cube[2][1]
                            )
                            )
                )
          )
            
      ),
      list("dimensions",list(for $dimension in ($UNIQUE_DIMENSION_NAMES + $NON_DOMAIN_DIMENSIONS)
        dict(list("name",$dimension[1].name),
            if $dimension[2] == 'typed'
                list("domainDataType",if $BASE_TYPES[$dimension[1].data-type.name] == none $dimension[1].data-type.name else $BASE_TYPES[$dimension[1].data-type.name] )  // TODO Need a function to return the type of a typed dimension
            else
                list("domainClass",$dimension[3])
        )
      )
      ),
      list("labels",list(for $concept in $OLD_CONCEPTS
                          if $concept.all-labels == none
                            skip
                          else
                            for $label in $concept.all-labels
          dict(list("relatedName",$concept.name),
              list("language",$label.lang),
                    list("value",$label.text),
                    list("labelType",if $label.role.uri in $BASE_LABELS.keys $BASE_LABELS[$label.role.uri] else qname($concept.name.namespace-uri, $label.role.uri.split('\/').last))
                  )
          ) + $CUBE_LABELS + $DIM_DOMAIN_LABELS + $PRIM_DOMAIN_LABELS + $GROUP_LABELS + $EXTENUM_DOMAIN_LABELS
      ),
      list("references",$REFERENCES
      ),
      $NETWORKS,
      list("cubes",list(for $cube in $CUBES
         $amended_cube_URI = if $cube.drs-role.uri.index-of($cube.cube-concept.name.local-name) == 0 $cube.drs-role.uri else $cube.drs-role.uri.substring(1,($cube.drs-role.uri.index-of($cube.cube-concept.name.local-name))-1)
          dict(list("name", qname($cube.cube-concept.name.namespace-uri,$cube.cube-concept.name.local-name + "_" + $cube.drs-role.uri.split('\/').last + "_Cube")),
              list("cubeType",qname("https://xbrl.org/2025","reportCube")),
              list("cubeDimensions",list(for $dimension in filter $cube.dimensions 
                  dict(list("dimensionName",$dimension.concept.name),
                      if $dimension.dimension-type == "explicit" list("domainName",qname($dimension.default.name.namespace-uri, $dimension.default.name.local-name + "_" + $cube.drs-role.uri.split('\/').last + "_DDomain")) else list(),
                      if $dimension.dimension-type == "explicit" list("allowDomainFacts",true) else list("allowDomainFacts",false)
                      )
                  ) + list(dict(list("dimensionName",qname("https://xbrl.org/2025","concept")),
                      list("domainName",qname($cube.cube-concept.name.namespace-uri, $cube.cube-concept.name.local-name + "_" + $cube.drs-role.uri.split('\/').last + "_PDomain"))
                      )
                  ) + list(dict(list("dimensionName",qname("https://xbrl.org/2025","period")),
                      list("allowDomainFacts",true)
                      )
                  ) + list(dict(list("dimensionName",qname("https://xbrl.org/2025","unit")),
                      list("allowDomainFacts",true)
                      )
                  ) + list(dict(list("dimensionName",qname("https://xbrl.org/2025","entity"))
                      )
                  )
              ),
              list("cubeNetworks",list(for $network in filter $NETWORKS_NO_DIMS where ($item.arcrole.uri.contains('parent-child') or $item.arcrole.uri.contains('summation-item')) and $item.role.uri == $amended_cube_URI
                  qname($CONVERT_TAXONOMY.entry-point-namespace,$network.role.uri.split('\/').last + "_" + $network.arcrole.uri.split('\/').last + "_Network")
                  )
              )
          )
        )
      ),
      $TYPES,
      $REF_TYPES,
      $LAB_TYPES,
      $RELATIONSHIP_TYPES,
      $PART_PROPERTIES,
      list("domains", $DIMENSION_DOMAINS + $PRIMARY_DOMAINS + $EXTENUM_DOMAINS
      ),
      list("domainClasses", list(for $domainRoot in $DIMENSION_DOMAINS_SET
              dict(list("name",$domainRoot)
        )
      ))

    )
    )
)

file-location $FILE_LOCATION
file-content $rule-value.to-json


constant $IFRS_2024 = taxonomy('https://xbrl.ifrs.org/taxonomy/2024-03-27/full_ifrs_entry_point_2024-03-27.xsd')
constant $IFRS_2025 = taxonomy('https://xbrl.ifrs.org/taxonomy/2025-03-27/full_ifrs_entry_point_2025-03-27.xsd')
