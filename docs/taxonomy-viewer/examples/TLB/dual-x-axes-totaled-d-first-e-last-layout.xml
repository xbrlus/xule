        <!--TableSet linkrole: http://www.xbrl.org/table-examples/table4-->
        <label>Table with dual breakdowns with roll-up on the x-axis</label>
        <table>
            <headers axis="y">
                <group>
                    <!--Breakdown node file: table-linkbase-dual-x-axes-totaled-d-first-e-last.xml, line 192-->
                    <label>Two rows (primary items m1, m2)</label>
                    <header>
                        <cell>
                            <!--Cell id table4-y.1-->
                            <label>Label: m1</label>
                            <constraint>
                                <aspect>concept</aspect>
                                <value>rend:m1</value>
                            </constraint>
                        </cell>
                        <cell>
                            <!--Cell id table4-y.2-->
                            <label>Label: m2</label>
                            <constraint>
                                <aspect>concept</aspect>
                                <value>rend:m2</value>
                            </constraint>
                        </cell>
                    </header>
                </group>
            </headers>
            <headers axis="x">
                <group>
                    <!--Breakdown node file: table-linkbase-dual-x-axes-totaled-d-first-e-last.xml, line 47-->
                    <label>Three columns (dimension D = d0, d1, d2)</label>
                    <header>
                        <cell span="9">
                            <!--Cell id table4-x1.1-->
                            <label>Label: D</label>
                            <constraint>
                                <aspect>rend:D</aspect>
                                <value/>
                            </constraint>
                        </cell>
                    </header>
                    <header>
                        <cell rollup="true" span="3"/>
                        <cell span="3">
                            <!--Cell id table4-x1.1.1-->
                            <label>Label: D = d1</label>
                            <constraint>
                                <aspect>rend:D</aspect>
                                <value>rend:d1</value>
                            </constraint>
                        </cell>
                        <cell span="3">
                            <!--Cell id table4-x1.1.2-->
                            <label>Label: D = d2</label>
                            <constraint>
                                <aspect>rend:D</aspect>
                                <value>rend:d2</value>
                            </constraint>
                        </cell>
                    </header>
                </group>
                <group>
                    <!--Breakdown node file: table-linkbase-dual-x-axes-totaled-d-first-e-last.xml, line 119-->
                    <label>Two columns (dimension E = e0, e1, e2)</label>
                    <header>
                        <cell span="3">
                            <!--Cell id table4-x2.1-->
                            <label>Label: E</label>
                            <constraint>
                                <aspect>rend:E</aspect>
                                <value/>
                            </constraint>
                        </cell>
                        <cell span="3">
                            <!--Cell id table4-x2.1-->
                            <label>Label: E</label>
                            <constraint>
                                <aspect>rend:E</aspect>
                                <value/>
                            </constraint>
                        </cell>
                        <cell span="3">
                            <!--Cell id table4-x2.1-->
                            <label>Label: E</label>
                            <constraint>
                                <aspect>rend:E</aspect>
                                <value/>
                            </constraint>
                        </cell>
                    </header>
                    <header>
                        <cell>
                            <!--Cell id table4-x2.1.1-->
                            <label>Label: E = e1</label>
                            <constraint>
                                <aspect>rend:E</aspect>
                                <value>rend:e1</value>
                            </constraint>
                        </cell>
                        <cell>
                            <!--Cell id table4-x2.1.2-->
                            <label>Label: E = e2</label>
                            <constraint>
                                <aspect>rend:E</aspect>
                                <value>rend:e2</value>
                            </constraint>
                        </cell>
                        <cell rollup="true"/>
                        <cell>
                            <!--Cell id table4-x2.1.1-->
                            <label>Label: E = e1</label>
                            <constraint>
                                <aspect>rend:E</aspect>
                                <value>rend:e1</value>
                            </constraint>
                        </cell>
                        <cell>
                            <!--Cell id table4-x2.1.2-->
                            <label>Label: E = e2</label>
                            <constraint>
                                <aspect>rend:E</aspect>
                                <value>rend:e2</value>
                            </constraint>
                        </cell>
                        <cell rollup="true"/>
                        <cell>
                            <!--Cell id table4-x2.1.1-->
                            <label>Label: E = e1</label>
                            <constraint>
                                <aspect>rend:E</aspect>
                                <value>rend:e1</value>
                            </constraint>
                        </cell>
                        <cell>
                            <!--Cell id table4-x2.1.2-->
                            <label>Label: E = e2</label>
                            <constraint>
                                <aspect>rend:E</aspect>
                                <value>rend:e2</value>
                            </constraint>
                        </cell>
                        <cell rollup="true"/>
                    </header>
                </group>
            </headers>
            <cells axis="z">
                <cells axis="y">
                    <cells axis="x">
                        <cell/>
                        <cell/>
                        <cell/>
                        <cell/>
                        <cell/>
                        <cell/>
                    </cells>
                    <cells axis="x">
                        <cell/>
                        <cell/>
                        <cell/>
                        <cell/>
                        <cell/>
                        <cell/>
                    </cells>
