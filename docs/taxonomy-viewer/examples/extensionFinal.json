{
    "$schema": "../oim-taxonomy-schema.json",
    "documentInfo": {
        "documentType": "https://xbrl.org/2026/model",
        "documentNamespace": "exp_extF",
        "namespaces": {
            "exp": "http://example.com/taxonomy",
            "mini": "http://example.com/mini",
            "exp_ext": "http://example.com/ext-taxonomy",
            "xbrl": "https://xbrl.org/2025",
            "iso4217": "http://www.xbrl.org/2003/iso4217",
            "utr": "https://xbrl.org/2025/utr",
