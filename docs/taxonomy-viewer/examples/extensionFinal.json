            "xs": "http://www.w3.org/2001/XMLSchema",
            "exp_extF": "http://example.com/ext-final-taxonomy"
        },
        "importMapping": {
            "exp:SampleTaxonomy": "exampleTaxonomy.json"
        }
    },
    "xbrlModel": {
        "name": "exp_extF:ExtensionTaxonomyFinal",
        "importedTaxonomies": [
