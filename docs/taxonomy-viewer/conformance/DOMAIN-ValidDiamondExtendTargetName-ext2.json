{
  "$schema": "../oim-taxonomy-schema.json",
  "documentInfo": {
    "documentType": "https://xbrl.org/2026/model",
    "namespaces": {
      "exp": "http://example.com/taxonomy/base",
      "exp3": "http://example.com/taxonomy/ext2",
      "xbrl": "https://xbrl.org/2025",
      "xbrli": "https://xbrl.org/2025/instance",
      "xs": "http://www.w3.org/2001/XMLSchema"
    },
    "documentNamespace": "exp3",
    "description": "VALID: Extension taxonomy C independently importing A and extending exp:ProductDomain with exp3:ProductC. In C's resolved model the domain contains exp:ProductA and exp3:ProductC. C has no knowledge of taxonomy B.",
    "importMapping": {
      "exp:DiamondBase": "./DOMAIN-ValidDiamondExtendTargetName-base.json"
    }
  },
  "xbrlModel": {
    "name": "exp3:DiamondExt2",
    "version": "2025",
    "importedTaxonomies": [
      {
        "xbrlModelName": "exp:DiamondBase"
      }
    ],
    "concepts": [
      {
        "name": "exp3:ProductC",
        "dataType": "xbrli:monetary",
        "periodType": "duration"
      }
    ],
    "domains": [
      {
        "extendTargetName": "exp:ProductDomain",
        "relationships": [
          {
            "source": "xbrl:conceptDomain",
            "target": "exp3:ProductC"
          }
        ]
      }
    ]
  }
}
