{
  "$schema": "../oim-taxonomy-schema.json",
  "documentInfo": {
    "documentType": "https://xbrl.org/2026/model",
    "namespaces": {
      "exp": "http://example.com/taxonomy",
      "xbrl": "https://xbrl.org/2025",
      "xs": "http://www.w3.org/2001/XMLSchema"
    },
    "documentNamespace": "exp",
    "description": "ERROR: oimte:invalidDomainClass - DomainClass references concept object."
  },
  "xbrlModel": {
    "name": "exp:DimensionBothDomainDataTypeAndDomainClass",
    "version": "2025",
    "dimensions": [
      {
        "name": "exp:MyDimension",
        "domainClass": "exp:MyConcept"
      }
    ],
    "domainClasses": [
      { "name": "exp:MyDomainClass" }
    ],
     "concepts": [
      { 
        "name": "exp:MyConcept", 
        "dataType": "xs:string", 
        "periodType": "duration" 
      }
    ]
  }
}