{
    "$schema": "../oim-taxonomy-schema.json",
    "documentInfo": {
        "documentType": "https://xbrl.org/2026/model",
        "namespaces": {
            "entry": "http://example.com/entry",
            "exp": "http://example.com/financials",
            "geo": "http://example.com/geography",
            "xbrl": "https://xbrl.org/2025",
            "xs": "http://www.w3.org/2001/XMLSchema"
        },
        "documentNamespace": "entry",
        "description": "Valid: the importing model imports two modules that both declare the prefix 'exp' for different namespace URIs. The collision on the geography import is resolved by declaring prefixRemap { 'geo': 'exp' }, which tells the processor that the 'exp' prefix in geography-module.json corresponds to the 'geo' alias in this importing model. No oimce:multipleAliasesForURI error is raised.",
        "importMapping": {
            "exp:FinancialsModel": "NAMESPACE-financials-module.json",
            "geo:GeographyModel": "NAMESPACE-geography-module.json"
        }
    },
    "xbrlModel": {
        "name": "entry:EntryModel",
        "importedTaxonomies": [
            {
                "xbrlModelName": "exp:FinancialsModel"
            },
            {
                "xbrlModelName": "geo:GeographyModel",
                "prefixRemap": {
                    "geo": "exp"
                }
            }
        ]
    }
}