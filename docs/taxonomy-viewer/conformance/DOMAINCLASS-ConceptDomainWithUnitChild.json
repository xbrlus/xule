{
  "$schema": "../oim-taxonomy-schema.json",
  "documentInfo": {
    "documentType": "https://xbrl.org/2026/model",
    "namespaces": {
      "exp": "http://example.com/taxonomy",
      "xbrl": "https://xbrl.org/2025",
      "xbrli": "https://xbrl.org/2025/instance",
      "xs": "http://www.w3.org/2001/XMLSchema"
    },
    "documentNamespace": "exp",
    "description": "ERROR: conceptDomain used as root, but domain includes a relationship to a unit object (not a concept object)."
  },
  "xbrlModel": {
    "name": "exp:ConceptDomainWithUnitChild",
    "version": "2025",
    "domainClasses": [
      { "name": "xbrl:conceptDomain" }
    ],
    "domains": [
      {
        "name": "exp:TestDomain",
        "root": "xbrl:conceptDomain",
        "relationships": [
          {
            "source": "xbrl:conceptDomain",
            "target": "exp:SomeUnit"
          }
        ]
      }
    ],
    "units": [
      {
        "name": "exp:SomeUnit",
        "dataType": "xs:string"
      }
    ]
  }
}
