{
    "$schema": "../oim-taxonomy-schema.json",
    "documentInfo": {
        "documentType": "https://xbrl.org/2026/model",
        "namespaces": {
            "exp": "http://example.com/taxonomy",
            "xbrl": "https://xbrl.org/2025",
            "xbrli": "https://xbrl.org/2025/instance",
            "xs": "http://www.w3.org/2001/XMLSchema"
        },
        "documentNamespace": "exp",
        "description": "Valid map type definition with requiredKeys, allowedKeys, and a property value that satisfies all constraints."
    },
    "xbrlModel": {
        "name": "exp:ValidMapWithRequiredAndAllowedKeys",
        "version": "2025",
        "dataTypes": [
            {
                "name": "exp:ConfigMap",
                "baseType": "xbrli:map",
                "mapType": {
                    "keyType": "xs:string",
                    "valueType": "xs:string",
                    "requiredKeys": ["unit", "currency"],
                    "allowedKeys": ["unit", "currency", "precision"]
                }
            }
        ],
        "propertyTypes": [
            {
                "name": "exp:ConfigProperty",
                "dataType": "exp:ConfigMap"
            }
        ],
        "concepts": [
            {
                "name": "exp:Revenue",
                "dataType": "xbrli:monetary",
                "periodType": "duration",
                "properties": [
                    {
                        "property": "exp:ConfigProperty",
                        "value": { "unit": "USD", "currency": "USD", "precision": "2" }
                    }
                ]
            }
        ]
    }
}
