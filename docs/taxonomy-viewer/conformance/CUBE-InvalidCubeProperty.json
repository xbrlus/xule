{
    "$schema": "../oim-taxonomy-schema.json",
    "documentInfo": {
        "documentType": "https://xbrl.org/2026/model",
        "namespaces": {
            "exp": "http://example.com/taxonomy",
            "xbrl": "https://xbrl.org/2025",
            "xbrla": "http://xbrl.org/accounting",
            "xbrli": "https://xbrl.org/2025/instance",
            "xs": "http://www.w3.org/2001/XMLSchema"
        },
        "documentNamespace": "exp",
        "description": "ERROR: Cube has a property xbrla:balance, which is not a permitted property for a cube.",
        "importMapping": {
            "xbrla:AccountingModel": "../spec-taxonomies/xbrla.json"
        }
    },
    "xbrlModel": {
        "name": "exp:CubeWithInvalidPropertyTaxonomy",
        "version": "2025",
        "importedTaxonomies": [
            {
                "xbrlModelName": "xbrla:AccountingModel"
            }
        ],
        "concepts": [
            {
                "name": "exp:SomeConcept",
                "dataType": "xs:string",
                "periodType": "duration"
            }
        ],
        "dimensions": [
            {
                "name": "exp:TimeSeriesDimension",
                "domainClass": "exp:PrimaryTimeSeriesDomainClass"
            }
        ],
        "cubes": [
            {
                "name": "exp:CubeWithInvalidProperty",
                "cubeType": "xbrla:timeSeriesCube",
                "cubeDimensions": [
                    {
                        "dimensionName": "xbrl:concept",
                        "domainName": "exp:PrimaryTimeSeriesDomain"
                    },
                    {
                        "dimensionName": "exp:TimeSeriesDimension",
                        "allowDomainFacts": false
                    }
                ],
                "properties": [
                    {
                        "property": "xbrla:balance",
                        "value": "credit"
                    }
                ]
            }
        ],
        "domains": [
            {
                "name": "exp:PrimaryTimeSeriesDomain",
                "root": "xbrl:conceptDomain",
                "relationships": [
                    {
                        "source": "xbrl:conceptDomain",
                        "target": "exp:SomeConcept"
                    }
                ]
            }
        ],
        "domainClasses": [
            {
                "name": "exp:PrimaryTimeSeriesDomainClass"
            }
        ]
    }
}