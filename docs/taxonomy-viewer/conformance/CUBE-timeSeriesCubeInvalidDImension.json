{
  "$schema": "../oim-taxonomy-schema.json",
  "documentInfo": {
    "documentType": "https://xbrl.org/2026/model",
    "namespaces": {
      "exp": "http://example.com/taxonomy",
      "xbrl": "https://xbrl.org/2025",
      "xbrli":"https://xbrl.org/2025/instance",
      "xs": "http://www.w3.org/2001/XMLSchema"
    },
    "documentNamespace": "exp",
    "description": "ERROR: Example taxonomy with an invalid time series cube. Dimension should be xs:dateTime for timeSeriesCube not xs:string - line28"
  },
  "xbrlModel": {
    "name": "exp:InvalidTimeSeriesTaxonomy",
    "version": "2025",
     "concepts": [
            {
                "name": "exp:PeakGridElectricityDemand",
                "dataType": "xbrli:power",
                "periodType": "none",
                "nillable": true
            }
        ],
    "dimensions": [
      {
        "name": "exp:TimeSeriesDimension",
        "domainClass": "exp:TimeSeriesDimensionDomainClass"
      }
    ],
    "domainClasses": [
      {
        "name": "exp:TimeSeriesDimensionDomainClass",
        "allowedDomainItems" : ["xs:string"]
      }
    ],
    "cubes": [
      {
        "name": "exp:InvalidTimeSeriesCube",
        "cubeType": "xbrla:timeSeriesCube",
        "cubeDimensions": [
          {
            "dimensionName": "exp:TimeSeriesDimension",
            "allowDomainFacts": false
          },
          {
            "dimensionName": "xbrl:concept",
            "domainName": "exp:PrimaryTimeSeriesDomain"
          }
        ]
      }
    ],
    "domains": [
        {
            "name": "exp:PrimaryTimeSeriesDomain",
            "root": "xbrl:conceptDomain",
            "relationships": [
                {
                    "source": "xbrl:conceptDomain",
                    "target": "exp:PeakGridElectricityDemand"
                }
            ]
          }
    ]
  }
}