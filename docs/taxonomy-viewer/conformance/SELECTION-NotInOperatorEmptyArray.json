{
    "$schema": "../oim-taxonomy-schema.json",
    "documentInfo": {
        "documentType": "https://xbrl.org/2026/model",
        "namespaces": {
            "ext": "http://extension.com/taxonomy",
            "xbrl": "https://xbrl.org/2025",
            "xs": "http://www.w3.org/2001/XMLSchema",
            "exp": "http://example.com/taxonomy"
        },
        "documentNamespace": "ext",
        "description": "ERROR: oimte:invalidSelectionExpression - The 'not in' operator requires a non-empty JSON array as its value. An empty array is provided, which violates constraint 7 of the Selection Expression Grammar appendix.",
        "importMapping": {
            "exp:SampleTaxonomy": "../examples/exampleTaxonomy.json"
        }
    },
    "xbrlModel": {
        "name": "ext:SelectionNotInOperatorEmptyArray",
        "version": "2025",
        "importedTaxonomies": [
            {
                "xbrlModelName": "exp:SampleTaxonomy",
                "selections": [
                    {
                        "objectType": "xbrl:conceptObject",
                        "where": [
                            {
                                "property": "periodType",
                                "operator": "not in",
                                "value": []
                            }
                        ]
                    }
                ]
            }
        ]
    }
