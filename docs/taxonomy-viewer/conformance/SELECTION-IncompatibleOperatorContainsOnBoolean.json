{
    "$schema": "../oim-taxonomy-schema.json",
    "documentInfo": {
        "documentType": "https://xbrl.org/2026/model",
        "namespaces": {
            "ext": "http://extension.com/taxonomy",
            "xbrl": "https://xbrl.org/2025",
            "xs": "http://www.w3.org/2001/XMLSchema",
            "exp": "http://example.com/taxonomy"
        },
        "documentNamespace": "ext",
        "description": "ERROR: oimte:invalidSelectionExpression - The 'contains' operator is used against the 'nillable' property, which has an effective type of xs:boolean. The 'contains' operator is only permitted for string properties.",
        "importMapping": {
            "exp:SampleTaxonomy": "../examples/exampleTaxonomy.json"
        }
    },
    "xbrlModel": {
        "name": "ext:SelectionIncompatibleOperatorContainsOnBoolean",
        "version": "2025",
        "importedTaxonomies": [
            {
                "xbrlModelName": "exp:SampleTaxonomy",
                "selections": [
                    {
                        "objectType": "xbrl:conceptObject",
                        "where": [
                            {
                                "property": "nillable",
                                "operator": "contains",
                                "value": "true"
                            }
                        ]
                    }
                ]
            }
        ]
    }
}