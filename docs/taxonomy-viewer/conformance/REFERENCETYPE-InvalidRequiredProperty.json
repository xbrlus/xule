{
  "$schema": "../oim-taxonomy-schema.json",
  "documentInfo": {
    "documentType": "https://xbrl.org/2026/model",
    "namespaces": {
      "exp": "http://example.com/taxonomy",
      "xbrl": "https://xbrl.org/2025",
      "xbrli": "https://xbrl.org/2025/instance",
      "xs": "http://www.w3.org/2001/XMLSchema"
    },
    "documentNamespace": "exp",
    "description": "ERROR: The required property for the reference is a property that is not applicable for a reference."
  },
  "xbrlModel": {
    "name": "exp:RefersToInvalidRequiredProperty",
    "version": "2025",
    "propertyTypes": [
      {
        "name": "exp:IntegerProperty",
        "dataType": "xs:integer",
        "allowedObjects": ["xbrl:referenceObject"]
      },
      {
        "name": "exp:ConceptProperty",
        "dataType": "xs:integer",
        "allowedObjects": ["xbrl:conceptObject"]
      }
    ],
    "references": [
      {
        "name": "exp:myReference",
        "referenceType": "exp:MyReferenceType",
        "properties": [
          {
            "property": "exp:IntegerProperty",
            "value": "test"
          }
        ]
      }
    ],
    "referenceTypes": [
        {
            "name": "exp:MyReferenceType",
            "allowedObjects": ["xbrl:referenceObject"],
            "requiredProperties": ["exp:IntegerProperty","exp:ConceptProperty"]

        }
    ]
  }
}