{
  "$schema": "../oim-taxonomy-schema.json",
  "documentInfo": {
    "documentType": "https://xbrl.org/2026/model",
    "namespaces": {
      "exp": "http://example.com/taxonomy",
      "xbrl": "https://xbrl.org/2025",
      "xbrli": "https://xbrl.org/2025/instance",
      "xbrla": "http://xbrl.org/accounting",
      "xs": "http://www.w3.org/2001/XMLSchema",
      "iso4217": "http://www.xbrl.org/2003/iso4217"
    },
    "documentNamespace": "exp",
    "urlMapping": {
            "xbrla": ["../spec-taxonomies/xbrla.json"]
            },
    "description": "VALID: weight=-1, reconciliation not defined — source and target concepts have DIFFERENT xbrla:balance values (source credit, target debit). GrossProfit (credit) = (-1) * CostOfGoodsSold (debit). A weight=-1 relationship without reconciliation requires different balance values on source and target. This document should produce NO errors."
  },
  "xbrlModel": {
    "name": "exp:WeightMinus1DifferentBalanceValid",
    "version": "2025",
    "importedTaxonomies": [
            {
                "xbrlModelName": "xbrla:AccountingModel"
            }
        ],

    "concepts": [
      {
        "name": "exp:GrossProfit",
        "dataType": "xbrli:monetary",
        "periodType": "duration",
        "properties": [{ "property": "xbrla:balance", "value": "credit" }]
      },
      {
        "name": "exp:CostOfGoodsSold",
        "dataType": "xbrli:monetary",
        "periodType": "duration",
        "properties": [{ "property": "xbrla:balance", "value": "debit" }]
      }
    ],

    "domains": [
      {
        "name": "exp:IncomeDomain",
        "root": "xbrl:conceptDomain",
        "relationships": [
          { "source": "xbrl:conceptDomain", "target": "exp:GrossProfit" },
          { "source": "xbrl:conceptDomain", "target": "exp:CostOfGoodsSold" }
        ]
      }
    ],

    "networks": [
      {
        "name": "exp:IncomePresentation",
        "relationshipTypeName": "xbrl:parent-child",
        "roots": ["exp:GrossProfit"],
        "relationships": [
          { "source": "exp:GrossProfit", "target": "exp:CostOfGoodsSold" }
        ]
      },
      {
        "name": "exp:IncomeCalculation",
        "relationshipTypeName": "xbrl:summation-item",
        "roots": ["exp:GrossProfit"],
        "relationships": [
          {
            "source": "exp:GrossProfit",
            "target": "exp:CostOfGoodsSold",
            "properties": [{ "property": "xbrl:weight", "value": "-1" }]
          }
        ]
      }
    ],

    "cubes": [
      {
        "name": "exp:IncomeCube",
        "cubeType": "xbrl:reportCube",
        "cubeNetworks": ["exp:IncomePresentation", "exp:IncomeCalculation"],
        "cubeDimensions": [
          { "dimensionName": "xbrl:period" },
          { "dimensionName": "xbrl:concept", "domainName": "exp:IncomeDomain" },
          { "dimensionName": "xbrl:unit", "allowDomainFacts": true },
          { "dimensionName": "xbrl:entity" }
        ]
      }
    ],

    "facts": [
      {
        "name": "exp:GrossProfitFact",
        "factDimensions": {
          "xbrl:concept": "exp:GrossProfit",
          "xbrl:period": "2025-01-01T00:00:00/2026-01-01T00:00:00",
          "xbrl:unit": "iso4217:USD",
          "xbrl:entity": "exp:ExampleCompany"
        },
        "factValues": [{ "value": "400000", "decimals": 0 }]
      },
      {
        "name": "exp:CostOfGoodsSoldFact",
        "factDimensions": {
          "xbrl:concept": "exp:CostOfGoodsSold",
          "xbrl:period": "2025-01-01T00:00:00/2026-01-01T00:00:00",
          "xbrl:unit": "iso4217:USD",
          "xbrl:entity": "exp:ExampleCompany"
        },
        "factValues": [{ "value": "600000", "decimals": 0 }]
      }
    ],

    "entities": [
      { "name": "exp:ExampleCompany" }
    ],

    "labels": [
      { "relatedName": "exp:GrossProfit",      "labelType": "xbrl:label", "language": "en", "value": "Gross Profit" },
      { "relatedName": "exp:CostOfGoodsSold",  "labelType": "xbrl:label", "language": "en", "value": "Cost of Goods Sold" },
      { "relatedName": "exp:IncomeCube",       "labelType": "xbrl:label", "language": "en", "value": "Income Statement" }
    ]
  }
}
