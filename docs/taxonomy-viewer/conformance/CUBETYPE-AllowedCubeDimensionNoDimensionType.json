{
  "$schema": "../oim-taxonomy-schema.json",
  "documentInfo": {
    "documentType": "https://xbrl.org/2026/model",
    "namespaces": {
      "exp": "http://example.com/taxonomy",
      "xbrl": "https://xbrl.org/2025",
      "xbrli": "https://xbrl.org/2025/instance",
      "xs": "http://www.w3.org/2001/XMLSchema"
    },
    "documentNamespace": "exp",
    "description": "Example: dimensions datatype is defined as xbrl:concept, which is not valid."
  },
  "xbrlModel": {
    "name": "exp:CubeTypeAllowedCubeDimensionNoDimensionType",
    "version": "2025",
    "cubeTypes": [
      {
        "name": "exp:myCubeType",
        "coreDimensions": ["xbrl:concept", "xbrl:unit", "xbrl:entity"],
        "cubeDimensionConstraints" : {
            "allowed": [
                {
                    "dataType": "xbrl:concept",
                    "required": true
                }
            ],
            "closed" : true
        }
      }
    ]
  }
}