{
    "$schema": "../oim-taxonomy-schema.json",
    "documentInfo": {
        "documentType": "https://xbrl.org/2026/model",
        "namespaces": {
            "exp": "http://example.com/taxonomy",
            "xbrl": "https://xbrl.org/2025",
            "xbrli": "https://xbrl.org/2025/instance",
            "xs": "http://www.w3.org/2001/XMLSchema",
            "xbrla": "http://xbrl.org/accounting"
        },
        "documentNamespace": "exp",
        "description": "ERROR: Cube contains duplicate dimensions for TimeSeriesDimension",
        "importMapping": {
            "xbrla:AccountingModel": "../spec-taxonomies/xbrla.json"
        }
    },
    "xbrlModel": {
        "name": "exp:DuplicateDimensionTaxonomy",
        "version": "2025",
        "importedTaxonomies": [
            {
                "xbrlModelName": "xbrla:AccountingModel"
            }
        ],
        "concepts": [
            {
                "name": "exp:PeakGridElectricityDemand",
                "dataType": "xbrli:power",
                "periodType": "none",
                "nillable": true
            }
        ],
        "dimensions": [
            {
                "name": "exp:TimeSeriesDimension",
                "domainClass": "exp:MyDomainClass"
            }
        ],
        "cubes": [
            {
                "name": "exp:CubeDuplicateDimension",
                "cubeType": "xbrla:timeSeriesCube",
                "cubeDimensions": [
                    {
                        "dimensionName": "exp:TimeSeriesDimension",
                        "domainName": "exp:SecondaryTimeSeriesDomain"
                    },
                    {
                        "dimensionName": "exp:TimeSeriesDimension",
                        "domainName": "exp:ThirdTimeSeriesDomain"
                    },
                    {
                        "dimensionName": "xbrl:concept",
                        "domainName": "exp:PrimaryTimeSeriesDomain"
                    }
                ]
            }
        ],
        "domains": [
            {
                "name": "exp:PrimaryTimeSeriesDomain",
                "root": "xbrl:conceptDomain",
                "relationships": [
                    {
                        "source": "xbrl:conceptDomain",
                        "target": "exp:PeakGridElectricityDemand"
                    }
                ]
            },
            {
                "name": "exp:SecondaryTimeSeriesDomain",
                "root": "exp:MyDomainClass",
                "relationships": [
                    {
                        "source": "exp:MyDomainClass",
                        "target": "exp:USA"
                    }
                ]
            },
            {
                "name": "exp:ThirdTimeSeriesDomain",
                "root": "exp:MyDomainClass",
                "relationships": [
                    {
                        "source": "exp:MyDomainClass",
                        "target": "exp:USA"
                    }
                ]
            }
        ],
        "domainClasses": [
            {
                "name": "exp:MyDomainClass"
            }
        ],
        "members": [
            {
                "name": "exp:USA"
            }
        ]
    }
}