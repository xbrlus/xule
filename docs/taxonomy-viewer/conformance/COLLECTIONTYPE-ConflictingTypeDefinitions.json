{
    "$schema": "../oim-taxonomy-schema.json",
    "documentInfo": {
        "documentType": "https://xbrl.org/2026/model",
        "namespaces": {
            "exp": "http://example.com/taxonomy",
            "xbrl": "https://xbrl.org/2025",
            "xbrli": "https://xbrl.org/2025/instance",
            "xs": "http://www.w3.org/2001/XMLSchema"
        },
        "documentNamespace": "exp",
        "description": "ERROR: oimte:conflictingTypeDefinitions: A dataType object defines both a collectionType and a mapType."
    },
    "xbrlModel": {
        "name": "exp:ConflictingTypeDefinitionsModel",
        "version": "2025",
        "dataTypes": [
            {
                "name": "exp:ConflictingType",
                "baseType": "xbrli:map",
                "mapType": {
                    "keyType": "xs:string",
                    "valueType": "xs:string"
                },
                "collectionType": {
                    "dataTypesAllowed": ["xs:string"]
                }
            }
        ]
    }
}
