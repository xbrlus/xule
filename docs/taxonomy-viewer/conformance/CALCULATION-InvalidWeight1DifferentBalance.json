{
  "$schema": "../oim-taxonomy-schema.json",
  "documentInfo": {
    "documentType": "https://xbrl.org/2026/model",
    "namespaces": {
      "exp": "http://example.com/taxonomy",
      "xbrl": "https://xbrl.org/2025",
      "xbrli": "https://xbrl.org/2025/instance",
      "xbrla": "http://xbrl.org/accounting",
      "xs": "http://www.w3.org/2001/XMLSchema",
      "iso4217": "http://www.xbrl.org/2003/iso4217"
    },
    "documentNamespace": "exp",
    "urlMapping": {
            "xbrla": ["../spec-taxonomies/xbrla.json"]
            },
    "description": "ERROR: oimte:conceptPropertiesInconsistentWithSummationItemRelationship — weight=1, reconciliation not defined, but source and target have DIFFERENT xbrla:balance values. NetAssets (credit) = (+1) * TotalAssets (debit). A weight=1 relationship without reconciliation requires the same balance on both concepts. This combination is invalid and MUST raise an error."
  },
  "xbrlModel": {
    "name": "exp:Weight1DifferentBalanceInvalid",
    "version": "2025",
    "importedTaxonomies": [
            {
                "xbrlModelName": "xbrla:AccountingModel"
            }
        ],

    "concepts": [
      {
        "name": "exp:NetAssets",
        "dataType": "xbrli:monetary",
        "periodType": "instant",
        "properties": [{ "property": "xbrla:balance", "value": "credit" }]
      },
      {
        "name": "exp:TotalAssets",
        "dataType": "xbrli:monetary",
        "periodType": "instant",
        "properties": [{ "property": "xbrla:balance", "value": "debit" }]
      }
    ],

    "domains": [
      {
        "name": "exp:BalanceDomain",
        "root": "xbrl:conceptDomain",
        "relationships": [
          { "source": "xbrl:conceptDomain", "target": "exp:NetAssets" },
          { "source": "xbrl:conceptDomain", "target": "exp:TotalAssets" }
        ]
      }
    ],

    "networks": [
      {
        "name": "exp:BalancePresentation",
        "relationshipTypeName": "xbrl:parent-child",
        "roots": ["exp:NetAssets"],
        "relationships": [
          { "source": "exp:NetAssets", "target": "exp:TotalAssets" }
        ]
      },
      {
        "name": "exp:BalanceCalculation",
        "relationshipTypeName": "xbrl:summation-item",
        "roots": ["exp:NetAssets"],
        "relationships": [
          {
            "source": "exp:NetAssets",
            "target": "exp:TotalAssets",
            "properties": [{ "property": "xbrl:weight", "value": "1" }]
          }
        ]
      }
    ],

    "cubes": [
      {
        "name": "exp:BalanceCube",
        "cubeType": "xbrl:reportCube",
        "cubeNetworks": ["exp:BalancePresentation", "exp:BalanceCalculation"],
        "cubeDimensions": [
          { "dimensionName": "xbrl:period" },
          { "dimensionName": "xbrl:concept", "domainName": "exp:BalanceDomain" },
          { "dimensionName": "xbrl:unit", "allowDomainFacts": true },
          { "dimensionName": "xbrl:entity" }
        ]
      }
    ],

    "facts": [
      {
        "name": "exp:NetAssetsFact",
        "factDimensions": {
          "xbrl:concept": "exp:NetAssets",
          "xbrl:period": "2026-01-01T00:00:00",
          "xbrl:unit": "iso4217:USD",
          "xbrl:entity": "exp:ExampleCompany"
        },
        "factValues": [{ "value": "650000", "decimals": 0 }]
      },
      {
        "name": "exp:TotalAssetsFact",
        "factDimensions": {
          "xbrl:concept": "exp:TotalAssets",
          "xbrl:period": "2026-01-01T00:00:00",
          "xbrl:unit": "iso4217:USD",
          "xbrl:entity": "exp:ExampleCompany"
        },
        "factValues": [{ "value": "650000", "decimals": 0 }]
      }
    ],

    "entities": [
      { "name": "exp:ExampleCompany" }
    ],

    "labels": [
      { "relatedName": "exp:NetAssets",   "labelType": "xbrl:label", "language": "en", "value": "Net Assets" },
      { "relatedName": "exp:TotalAssets", "labelType": "xbrl:label", "language": "en", "value": "Total Assets" },
      { "relatedName": "exp:BalanceCube", "labelType": "xbrl:label", "language": "en", "value": "Balance Sheet" }
    ]
  }
}
