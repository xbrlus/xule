{
  "$schema": "../oim-taxonomy-schema.json",
  "documentInfo": {
    "documentType": "https://xbrl.org/2026/model",
    "namespaces": {
      "exp": "http://example.com/taxonomy",
      "xbrl": "https://xbrl.org/2025",
      "xbrli": "https://xbrl.org/2025/instance",
      "xs": "http://www.w3.org/2001/XMLSchema"
    },
    "documentNamespace": "exp",
    "description": "ERROR: A cube with cubeType xbrl:negativeCube MUST NOT specify the excludeCubes property."
  },
  "xbrlModel": {
    "name": "exp:NegativeCubeWithExcludeCubesTaxonomy",
    "version": "2025",
    "concepts": [
      {
        "name": "exp:Revenue",
        "dataType": "xbrli:monetaryItemType",
        "periodType": "duration",
        "nillable": true
      },
      {
        "name": "exp:ExcludedRevenue",
        "dataType": "xbrli:monetaryItemType",
        "periodType": "duration",
        "nillable": true
      }
    ],
    "domains": [
      {
        "name": "exp:RevenueDomain",
        "root": "xbrl:conceptDomain",
        "relationships": [
          {
            "source": "xbrl:conceptDomain",
            "target": "exp:Revenue"
          }
        ]
      },
      {
        "name": "exp:ExcludedRevenueDomain",
        "root": "xbrl:conceptDomain",
        "relationships": [
          {
            "source": "xbrl:conceptDomain",
            "target": "exp:ExcludedRevenue"
          }
        ]
      }
    ],
    "cubes": [
      {
        "name": "exp:AnotherNegativeCube",
        "cubeType": "xbrl:negativeCube",
        "cubeDimensions": [
          {
            "dimensionName": "xbrl:concept",
            "domainName": "exp:ExcludedRevenueDomain"
          },
          {
            "dimensionName": "xbrl:period"
          },
          {
            "dimensionName": "xbrl:unit",
            "allowDomainFacts": true
          },
          {
            "dimensionName": "xbrl:entity"
          }
        ]
      },
      {
        "name": "exp:InvalidNegativeCube",
        "cubeType": "xbrl:negativeCube",
        "cubeDimensions": [
          {
            "dimensionName": "xbrl:concept",
            "domainName": "exp:RevenueDomain"
          },
          {
            "dimensionName": "xbrl:period"
          },
          {
            "dimensionName": "xbrl:unit",
            "allowDomainFacts": true
          },
          {
            "dimensionName": "xbrl:entity"
          }
        ],
        "excludeCubes": [
          "exp:AnotherNegativeCube"
        ]
      }
    ]
  }
}
