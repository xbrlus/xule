{
  "$schema": "../oim-taxonomy-schema.json",
  "documentInfo": {
    "documentType": "https://xbrl.org/2026/model",
    "namespaces": {
      "exp": "http://example.com/taxonomy",
      "xbrl": "https://xbrl.org/2025",
      "xbrli": "https://xbrl.org/2025/instance",
      "xs": "http://www.w3.org/2001/XMLSchema"
    },
    "documentNamespace": "exp",
    "description": "ERROR: cubeType references a concept object instead of a cubeType object."
  },
  "xbrlModel": {
    "name": "exp:CubeTypeIsConceptObjectTaxonomy",
    "version": "2025",
    "concepts": [
      {
        "name": "exp:SomeConcept",
        "dataType": "xs:string",
        "periodType": "duration"
      },
      {
          "name": "exp:PeakGridElectricityDemand",
          "dataType": "xbrli:power",
          "periodType": "duration",
          "nillable": true
      }
    ],
    "cubes": [
      {
        "name": "exp:CubeWithConceptAsCubeType",
        "cubeType": "exp:SomeConcept",
        "cubeDimensions": [
         {
            "dimensionName": "xbrl:concept",
            "domainName": "exp:PrimaryTimeSeriesDomain"
          },
          {
            "dimensionName": "xbrl:period"
          },
          {
            "dimensionName": "xbrl:unit",
            "allowDomainFacts": true
          },
          {
            "dimensionName": "xbrl:entity"
          }
        ]
      }
    ],
     "domains": [
      {
                "name": "exp:PrimaryTimeSeriesDomain",
                "root": "xbrl:conceptDomain",
                "relationships": [
                    {
                        "source": "xbrl:conceptDomain",
                        "target": "exp:PeakGridElectricityDemand"
                    }
                ]
            }
    ]
  }
}