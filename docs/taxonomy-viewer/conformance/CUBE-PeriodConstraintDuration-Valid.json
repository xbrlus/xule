            { "name": "exp:Assets", "dataType": "xs:decimal", "periodType": "instant", "nillable": true }
        ],
        "cubes": [
            {
                "name": "exp:DurationCube",
                "cubeType": "xbrl:reportCube",
                "cubeDimensions": [
                    {
                        "dimensionName": "xbrl:concept",
