                        "periodConstraints": [
                            { "periodType": "duration" }
                        ]
                    },
                    {
                        "dimensionName": "xbrl:unit",
                        "allowDomainFacts": true
                    },
                    {
                        "dimensionName": "xbrl:entity"
                    }
                ]
            }
        ],
        "domains": [
            {
                "name": "exp:ConceptDomain",
                "root": "xbrl:conceptDomain",
                "relationships": [
                    { "source": "xbrl:conceptDomain", "target": "exp:Revenue" },
                    { "source": "xbrl:conceptDomain", "target": "exp:Assets" }
                ]
            }
        ],
        "entities": [
            { "name": "exp:Company1" }
        ],
        "facts": [
            {
                "name": "exp:f1",
                "factValues": [{ "name": "exp:fv1", "value": "120000", "decimals": 0 }],
                "factDimensions": {
                    "xbrl:concept": "exp:Revenue",
                    "xbrl:period": "2025-01-01/2025-12-31",
                    "xbrl:entity": "exp:Company1"
                }
            },
            {
                "name": "exp:f2",
                "factValues": [{ "name": "exp:fv2", "value": "400000", "decimals": 0 }],
                "factDimensions": {
                    "xbrl:concept": "exp:Assets",
                    "xbrl:period": "2025-12-31",
                    "xbrl:entity": "exp:Company1"
                }
            }
        ]
    }
