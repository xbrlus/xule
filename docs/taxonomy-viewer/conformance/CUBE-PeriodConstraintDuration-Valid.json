{
    "$schema": "../oim-taxonomy-schema.json",
    "documentInfo": {
        "documentType": "https://xbrl.org/2026/model",
        "namespaces": {
            "exp": "http://example.com/taxonomy/period/duration",
            "xbrl": "https://xbrl.org/2025",
            "xbrli": "https://xbrl.org/2025/instance",
            "xs": "http://www.w3.org/2001/XMLSchema"
        },
        "documentNamespace": "exp",
        "description": "Valid: periodConstraint with periodType 'duration' restricts cube to duration facts. Includes a matching duration fact (included) and a non-matching instant fact (excluded)."
    },
    "xbrlModel": {
        "name": "exp:PeriodConstraintDurationValid",
        "version": "2025",
        "concepts": [
