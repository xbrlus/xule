{
  "$schema": "../oim-taxonomy-schema.json",
  "documentInfo": {
    "documentType": "https://xbrl.org/2026/model",
    "namespaces": {
      "ext": "http://extension.com/taxonomy",
      "xbrl": "https://xbrl.org/2025",
      "xs": "http://www.w3.org/2001/XMLSchema",
      "exp": "http://example.com/taxonomy"
    },
    "urlMapping": {
            "exp":  ["../examples/exampleTaxonomy.json"]
            },
    "documentNamespace": "ext",
    "description": "ERROR: oimte:invalidImportObjectType - Selections includes xbrl:importTaxonomyObject as object type, which is not allowed."
  },
  "xbrlModel": {
    "name": "ext:ImportTaxonomyInvalidSelectionObjectType",
    "version": "2025",
    "importedTaxonomies": [
      {
        "xbrlModelName": "exp:SampleTaxonomy",
        "selections": [
          {
            "objectType": "xbrl:importTaxonomyObject",
            "where": [
              { "property": "taxonomyName", "operator": "==", "value": "mini2:MiniTaxonomy2" }
            ]
          }
        ]
      }
    ]
  }
}