{
  "$schema": "../oim-taxonomy-schema.json",
  "documentInfo": {
    "documentType": "https://xbrl.org/2026/model",
    "namespaces": {
      "exp": "http://example.com/taxonomy",
      "xbrl": "https://xbrl.org/2025",
      "xbrli": "https://xbrl.org/2025/instance",
      "xs": "http://www.w3.org/2001/XMLSchema",
      "iso4217": "http://www.xbrl.org/2003/iso4217"
    },
    "documentNamespace": "exp",
    "description": "ERROR: oimte:invalidDomainObject Member exp:MyMember defined in concept dimension domain."
  },
  "xbrlModel": {
    "name": "exp:DomainWithMemberInConceptDimension",
    "version": "2025",
   "concepts": [
      {
        "name": "exp:Revenue",
        "dataType": "xbrli:monetary",
        "periodType": "duration"
      }
    ],
    "members" : [
        {
            "name": "exp:MyMember"
        },
        {
            "name": "exp:MyMember1"
        },
        {
            "name": "exp:MyMember2"
        }
    ],
    "abstracts" : [
      {
        "name": "exp:MyAbstract"
      }
    ],
    "domains": [
      {
        "name": "exp:DomainWithMember",
        "root": "exp:MyDimensionRoot",
        "relationships": [
          {
            "source": "exp:MyDimensionRoot", 
            "target": "exp:MyMember1"
          },
          {
            "source": "exp:MyDimensionRoot", 
            "target": "exp:MyMember2"
          }
        ]
      },
      {
        "name": "exp:PrimaryDomain",
        "root": "xbrl:conceptDomain",
        "relationships": [
          {
            "source": "xbrl:conceptDomain", 
            "target": "exp:Revenue"
          },
            {
                "source": "xbrl:conceptDomain", 
                "target": "exp:MyMember"
            }
        ]
        }
    ],
     "dimensions": [
      {
        "name": "exp:MyDimension",
        "domainClass": "exp:MyDimensionRoot"
      }
    ],
    "domainClasses": [
      {
        "name": "exp:MyDimensionRoot" ,
        "allowedDomainItems": ["xbrl:memberObject"]
     }
    ],
     "cubes": [
      {
        "name": "exp:myCube",
        "cubeDimensions": [
         {
            "dimensionName": "xbrl:concept",
            "domainName": "exp:PrimaryDomain"
          },
          {
            "dimensionName": "exp:MyDimension",
            "domainName": "exp:DomainWithMember",
            "allowDomainFacts": true
          },
          {
            "dimensionName": "xbrl:period"
          },
          {
            "dimensionName": "xbrl:unit",
            "allowDomainFacts": true
          },
          {
            "dimensionName": "xbrl:entity"
          }
        ]
      }
    ]
}
}