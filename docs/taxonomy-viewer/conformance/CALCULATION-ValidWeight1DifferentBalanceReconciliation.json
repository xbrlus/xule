            "iso4217": "http://www.xbrl.org/2003/iso4217"
        },
        "documentNamespace": "exp",
        "description": "VALID: weight=1, reconciliation=true — source and target concepts have DIFFERENT xbrla:balance values (source credit, target debit). ShareholdersEquity (credit) = (+1) * TotalAssets (debit). When reconciliation=true, a weight=1 relationship is valid when source and target have different balance values. This models the accounting equation Equity = Assets - Liabilities where the single +1 leg adds a debit item to a credit total. This document should produce NO errors.",
        "importMapping": {
            "xbrla:AccountingModel": "../spec-taxonomies/xbrla.json"
        }
    },
    "xbrlModel": {
        "name": "exp:Weight1DifferentBalanceReconciliationValid",
        "version": "2025",
        "importedTaxonomies": [
            {
                "xbrlModelName": "xbrla:AccountingModel"
            }
        ],
        "concepts": [
            {
                "name": "exp:ShareholdersEquity",
                "dataType": "xbrli:monetary",
                "periodType": "instant",
                "properties": [
                    {
                        "property": "xbrla:balance",
                        "value": "credit"
                    }
                ]
            },
            {
                "name": "exp:TotalAssets",
                "dataType": "xbrli:monetary",
                "periodType": "instant",
                "properties": [
                    {
                        "property": "xbrla:balance",
                        "value": "debit"
                    }
                ]
            }
        ],
        "domains": [
