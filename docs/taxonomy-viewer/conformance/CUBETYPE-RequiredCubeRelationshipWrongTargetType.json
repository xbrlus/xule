{
  "$schema": "../oim-taxonomy-schema.json",
  "documentInfo": {
    "documentType": "https://xbrl.org/2026/model",
    "namespaces": {
      "exp": "http://example.com/taxonomy",
      "xbrl": "https://xbrl.org/2025",
      "xbrli": "https://xbrl.org/2025/instance",
      "xs": "http://www.w3.org/2001/XMLSchema"
    },
    "documentNamespace": "exp",
    "description": "ERROR: requiredCubeRelationship specifies a targetObject of xbrl:dimensionObject, but the actual relationship in the cube network points to a concept object."
  },
  "xbrlModel": {
    "name": "exp:CubeTypeRequiredCubeRelationshipWrongTargetType",
    "version": "2025",
    "concepts": [
      { "name": "exp:MyConcept", "dataType": "xs:string", "periodType": "duration" },
      { "name": "exp:MyConcept2", "dataType": "xs:string", "periodType": "duration" }
    ],
    "dimensions": [
      { 
        "name": "exp:MyDimension", 
        "domainClass": "exp:MyDimensionRoot" 
      }
    ],
    "cubeTypes": [
      {
        "name": "exp:myCubeType",
        "requiredCubeRelationships": [
          {
            "relationshipTypeName": "xbrl:concept-refDimension",
            "sourceObject": "xbrl:conceptObject",
            "targetObject": "xbrl:dimensionObject"
          }
        ]
      }
    ],
    "cubes": [
      {
        "name": "exp:myCube",
        "cubeType": "exp:myCubeType",
        "cubeDimensions": [
         {
            "dimensionName": "xbrl:concept",
            "domainName": "exp:PrimaryTimeSeriesDomain"
          },
          {
            "dimensionName": "xbrl:period"
          },
          {
            "dimensionName": "xbrl:unit",
            "allowDomainFacts": true
          },
          {
            "dimensionName": "xbrl:entity"
          }
        ],
        "cubeNetworks": [
          "exp:ConceptToDimensionNetwork"
        ]
      }
    ],
    "networks": [
      {
        "name": "exp:ConceptToDimensionNetwork",
        "relationshipTypeName": "xbrl:concept-refDimension",
        "relationships": [
          {
            "source": "exp:MyConcept",
            "target": "exp:MyConcept2"
          }
        ]
      }
    ],
    "domains": [
      {
                "name": "exp:PrimaryTimeSeriesDomain",
                "root": "xbrl:conceptDomain",
                "relationships": [
                    {
                        "source": "xbrl:conceptDomain",
                        "target": "exp:SomeConcept"
                    }
                ]
            }
    ],
    "domainClasses": [
      {
        "name": "exp:MyDimensionRoot" 
     }
    ]
  }
}