{
  "$schema": "../oim-taxonomy-schema.json",
  "documentInfo": {
    "documentType": "https://xbrl.org/2026/model",
    "namespaces": {
      "ext": "http://extension.com/taxonomy",
      "xbrl": "https://xbrl.org/2025",
      "xs": "http://www.w3.org/2001/XMLSchema",
      "exp": "http://example.com/taxonomy"
    },
    "urlMapping": {
            "exp":  ["../examples/exampleTaxonomy.json"]
            },
    "documentNamespace": "ext",
    "description": "ERROR: oimte:conflictingImportProperties - Selections excludes labels and selects labels in the same import statement."
  },
  "xbrlModel": {
    "name": "ext:ImportTaxonomyInvalidLabelSelectionObjectType",
    "version": "2025",
    "importedTaxonomies": [
      {
        "xbrlModelName": "exp:SampleTaxonomy",
        "selections": [
          {
            "objectType": "xbrl:labelObject",
            "where": [
              { "property": "language", "operator": "==", "value": "en" }
            ]
          }
        ],
        "excludeLabels": true
      }
    ]
  }
}