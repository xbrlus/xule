{
  "$schema": "../oim-taxonomy-schema.json",
  "documentInfo": {
    "documentType": "https://xbrl.org/2026/model",
    "namespaces": {
      "exp": "http://example.com/taxonomy",
      "xbrl": "https://xbrl.org/2025",
      "xs": "http://www.w3.org/2001/XMLSchema",
      "iso4217": "http://www.xbrl.org/2003/iso4217"
    },
    "documentNamespace": "exp",
    "description": "Valid concept object with enumerationDomain property."
  },
  "xbrlModel": {
    "name": "exp:ValidEnumerationDomainConceptTaxonomy",
    "version": "2025",
    "concepts": [
      {
        "name": "exp:CurrencyUsed",
        "dataType": "xs:QName",
        "periodType": "instant",
        "enumerationDomain": "exp:MyUnitDomain"
      }
    ],
    "domains": [
      {
        "name": "exp:MyUnitDomain",
        "root": "xbrl:unitDomain",
        "relationships": [
          {
            "source": "xbrl:unitDomain",
            "target": "iso4217:NZD"
          },
         {
            "source": "xbrl:unitDomain",
            "target": "iso4217:USD"
          }
        ]
      }
    ]
  }
}
