{
  "$schema": "../oim-taxonomy-schema.json",
  "documentInfo": {
    "documentType": "https://xbrl.org/2026/model",
    "namespaces": {
      "exp": "http://example.com/taxonomy",
      "xbrl": "https://xbrl.org/2025",
      "xbrli": "https://xbrl.org/2025/instance",
      "xs": "http://www.w3.org/2001/XMLSchema",
       "iso4217": "http://www.xbrl.org/2003/iso4217"
    },
    "documentNamespace": "exp",
    "description": "ERROR: Domain class for unit Not Source In Relationship"
  },
  "xbrlModel": {
    "name": "exp:EntityDomainClassNotSourceInRelationship",
    "version": "2025",
    "domains": [
      {
        "name": "exp:MyUnitDomain",
        "root": "xbrl:unitDomain",
        "relationships": [
          {
            "source": "exp:SomeOtherConcept",
            "target": "iso4217:USD"
          }
        ]
      }
    ],
    "concepts": [
      {
        "name": "exp:SomeOtherConcept",
        "dataType": "xs:string",
        "periodType": "duration"
      },
      {
        "name": "exp:Revenue",
        "dataType": "xbrli:monetary",
        "periodType": "duration"
      }
    ],
    "entities": [
        {
            "name": "exp:MyEntity"
        }
    ]
}
}