{
	"compilerOptions": {
		"target": "es2020",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["es2020"],
		"sourceMap": true,
		"outDir": "out",
		"rootDir": "src",
		"esModuleInterop": true,
		"paths": {
			"vscode-languageserver": ["./node_modules/vscode-languageserver/lib/common/api.d.ts"],
			"vscode-languageserver/node": ["./node_modules/vscode-languageserver/lib/node/main.d.ts"],
			"vscode-languageserver-protocol": ["./node_modules/vscode-languageserver-protocol/lib/common/api.d.ts"],
			"vscode-languageserver-protocol/node": ["./node_modules/vscode-languageserver-protocol/lib/node/main.d.ts"],
			"vscode-jsonrpc": ["./node_modules/vscode-jsonrpc/lib/common/api.d.ts"],
			"vscode-jsonrpc/node": ["./node_modules/vscode-jsonrpc/lib/node/main.d.ts"]
		}
	},
	"include": ["src"],
	"exclude": ["node_modules", ".vscode-test"],
	"ts-node": {
		"transpileOnly": true,
		"compilerOptions": {
			"module": "commonjs",
			"moduleResolution": "node"
		}
	}
}
